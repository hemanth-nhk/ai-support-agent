# Copy this file to .env and adjust values as needed.
# No secrets are required for this project — Ollama runs locally with no API key.

DATABASE_PATH=data/support_agent.db

# Demo-level shared key required to call GET /customers/{id}/orders and the
# GraphQL customerOrders field -- these expose another person's order
# history, so they should not be open by default. Set any non-empty value
# for local testing. This is NOT real per-customer auth -- see app/api/auth.py.
SUPPORT_API_KEY=local-dev-demo-key-change-me
FAQ_DIR=data/faq
CHROMA_PERSIST_DIR=data/chroma_store
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RAG_SIMILARITY_THRESHOLD=0.42
RAG_TOP_K=3
# Optional distance threshold for uploaded session documents (leave empty for broad document QA, or set 0.60 for strict cutoff):
# UPLOADED_DOC_SIMILARITY_THRESHOLD=0.60
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
APP_NAME=AI Customer Support Agent
MAX_MESSAGE_LENGTH=500

# --- Tabular Analytics / Datasets ---
DATASETS_DIR=data/datasets
CHARTS_DIR=data/charts
MAX_DATASET_FILE_SIZE_MB=50

# --- Session Security ---
# Secret key used to sign session identity cookies and headers.
# Must be at least 32 characters. Generate locally with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=replace-with-a-secure-random-64-character-hex-string-see-readme
